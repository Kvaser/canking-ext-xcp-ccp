{
  "name": "daq-gui",
  "version": "1.1.0",
  "description": "Setup DAQ lists with selected signals & events",
  "author": "Kvaser AB",
  "canking": {
    "workspaceViewName": "DAQ Configurator",
    "extensionType": "WorkspaceView"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "user-guide.md"
  ],
  "scripts": {
    "start": "npm-run-all --parallel dev canking",
    "startpreview": "npm-run-all --parallel preview canking",
    "help": "start ./node_modules/@kvaser/canking-api/doc/index.html",
    "dev": "vite --port 4000",
    "preview": "vite preview --port 4000",
    "canking": "cross-env \"C:/Program Files/Kvaser CanKing/Kvaser CanKing.exe\" --ck-debug-pkg \"./package.json\" --ck-debug-port 4000",
    "package": "npm pack",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 && prettier --check src",
    "format": "prettier --write src",
    "transpile:wasm": "jco transpile ../target/wasm32-wasip2/release/a2l_daq.wasm -o src/a2l-daq-wasm --base64-cutoff 10000000",
    "build:wasm": "cargo rustc --manifest-path ../a2l-daq/Cargo.toml --lib --release --target wasm32-wasip2 --no-default-features --features component --crate-type cdylib && npm run transpile:wasm",
    "prepack": "npm run build",
    "prebuild": "rimraf dist"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "^0.19.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/roboto": "^5.2.10",
    "@kvaser/canking-api": "^7.6.1",
    "@mui/material": "^7.3.8",
    "@tanstack/react-virtual": "^3.14.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resize-detector": "^12.3.0"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.17.9",
    "@types/node": "^22.19.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
